# Copy to .env (this folder or server/) and fill in. Never commit .env.

# MongoDB connection string, e.g. from MongoDB Atlas:
#   mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/bakeria
MONGO_URI=mongodb://127.0.0.1:27017/bakeria

# Port for the website + API. Avoid 5000 on macOS (AirPlay Receiver uses it).
PORT=5050

# Shared staff PIN for Grandma's dashboard. Change this.
GRANDMA_PIN=1234

# Time zone for charts and the CSV export
TZ_NAME=America/Toronto
