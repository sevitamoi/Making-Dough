<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grandma's Bakeria</title>
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#35192e;--plum:#6b2d5c;--berry:#a63d6f;--butter:#f7d774;--pist:#b5d3a4;--paper:#fbf7fb;--card:#fff;--line:#e6d9e3;--warn:#c2410c;--ok:#2f7a4b;color-scheme:light}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 'DM Sans',system-ui,sans-serif}
h1,h2,h3{font-family:'Young Serif',Georgia,serif;font-weight:400;margin:0}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--berry);outline-offset:2px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:14px 24px;background:var(--ink);color:#fff}
.top h1{font-size:22px;color:var(--butter)}
.tabs{display:flex;gap:6px}
.tabs a{color:#fff;text-decoration:none;padding:8px 16px;border-radius:99px;border:1px solid #ffffff44}
.tabs a.on{background:var(--butter);color:var(--ink);border-color:var(--butter);font-weight:700}
main{max-width:1100px;margin:0 auto;padding:24px}
.lead{font-size:30px;margin-bottom:4px}
.sub{color:#6e5668;margin:0 0 18px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;align-items:center}
.chip{padding:6px 14px;border-radius:99px;border:1.5px solid var(--plum);background:#fff;color:var(--plum)}
.chip.on{background:var(--plum);color:#fff}
.layout{display:grid;grid-template-columns:1fr 320px;gap:24px;align-items:start}
@media(max-width:820px){.layout{grid-template-columns:1fr}}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.item{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}
.pic{height:96px;display:grid;place-items:center;font-size:48px}
.body{padding:14px;display:flex;flex-direction:column;gap:8px;flex:1}
.row{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.price{font-weight:700}
.ing{font-size:13px;color:#6e5668;margin:0}
.tags{display:flex;gap:6px;flex-wrap:wrap}
.tag{font-size:12px;padding:2px 8px;border-radius:6px;background:#f6e3ee;color:var(--plum)}
.tag.free{background:#e3f1db;color:var(--ok)}
.btn{border:0;border-radius:10px;padding:10px 14px;background:var(--plum);color:#fff;font-weight:700}
.btn:hover{background:var(--berry)}
.btn:disabled{background:#cdbfc9;cursor:not-allowed}
.btn.alt{background:#fff;color:var(--plum);border:1.5px solid var(--plum)}
.btn.sm{padding:6px 10px;font-size:14px}
.qty{display:flex;align-items:center;gap:10px}
.qty button{width:32px;height:32px;border-radius:50%;border:1.5px solid var(--plum);background:#fff;color:var(--plum);font-weight:700}
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.cart{position:sticky;top:16px}
.cart input{width:100%;padding:10px;border:1.5px solid var(--line);border-radius:8px;font:inherit;margin:8px 0}
.line{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px dashed var(--line)}
.total{font-weight:700;font-size:18px;margin:10px 0}
.empty{color:#8a7684}
.confirm{background:var(--butter);text-align:center}
.confirm .num{font-family:'Young Serif',serif;font-size:56px;line-height:1}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:20px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}
.stat b{display:block;font-family:'Young Serif',serif;font-size:30px;font-weight:400}
.stat.save{background:var(--pist);border-color:var(--pist)}
.alert{background:#fff1e6;border:1.5px solid var(--warn);color:var(--warn);border-radius:12px;padding:12px 16px;margin-bottom:20px;font-weight:500}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
@media(max-width:820px){.cols{grid-template-columns:1fr}}
.order{padding:12px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px}
.order.done{opacity:.45}
.order small{color:#6e5668;display:block}
.bar{height:10px;background:#efe3ec;border-radius:6px;overflow:hidden;margin-top:4px}
.bar i{display:block;height:100%;background:var(--ok)}
.bar i.low{background:var(--warn)}
.inv{margin-bottom:12px}
.inv .row span:last-child{font-variant-numeric:tabular-nums}
.low-t{color:var(--warn);font-weight:700}
.bs{display:grid;grid-template-columns:140px 1fr 30px;gap:10px;align-items:center;margin:8px 0}
.bs .bar{margin:0;height:14px}.bs .bar i{background:var(--berry)}
#qr{display:inline-block;padding:8px;background:#fff;border:1px solid var(--line);border-radius:10px}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.note{font-size:13px;color:#6e5668}
h2{font-size:22px;margin-bottom:10px}
@media(prefers-reduced-motion:no-preference){.confirm{animation:pop .35s ease-out}@keyframes pop{from{transform:scale(.94);opacity:0}}}
</style>
</head>
<body>
<header class="top">
  <h1>Grandma's Bakeria</h1>
  <nav class="tabs" aria-label="Views">
    <a href="#/" id="t-c">Customer menu</a>
    <a href="#/grandma" id="t-g">Grandma's dashboard</a>
  </nav>
</header>
<main id="app"></main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
/* ---------- Data ---------- */
const MENU=[
 {id:'parfait',name:'Fall Parfait',price:7.5,e:'🍂',bg:'#f7d774',ing:'Vanilla yogurt, spiced apples, maple granola, pumpkin swirl',al:['dairy','gluten','nuts'],r:{yogurt:120,granola:40,apples:60,pumpkin:20,pecans:5}},
 {id:'donut',name:'Apple Cider Donut',price:3.25,e:'🍩',bg:'#f2b8a2',ing:'Flour, apple cider, butter, sugar, eggs, cinnamon',al:['gluten','dairy','eggs'],r:{flour:70,apples:20,butter:20,sugar:25,eggs:0.5}},
 {id:'loaf',name:'Pumpkin Loaf Slice',price:4.0,e:'🎃',bg:'#f5c48a',ing:'Flour, pumpkin purée, sugar, eggs, butter, pecans',al:['gluten','dairy','eggs','nuts'],r:{flour:60,pumpkin:50,sugar:25,eggs:0.5,butter:15,pecans:8}},
 {id:'croissant',name:'Almond Croissant',price:4.75,e:'🥐',bg:'#e9d3a8',ing:'Flour, butter, almonds, sugar, eggs',al:['gluten','dairy','nuts','eggs'],r:{flour:60,butter:35,almonds:20,sugar:10,eggs:0.3}},
 {id:'scone',name:'Maple Pecan Scone',price:3.75,e:'🥧',bg:'#d9b99b',ing:'Flour, butter, pecans, maple sugar, eggs',al:['gluten','dairy','nuts','eggs'],r:{flour:80,butter:30,pecans:15,sugar:15,eggs:0.3}},
 {id:'applecup',name:'Baked Apple Cup',price:3.5,e:'🍎',bg:'#b5d3a4',ing:'Apples, brown sugar, cinnamon, oat crumble (dairy-free)',al:['gluten'],r:{apples:150,sugar:15,flour:15}}
];
const ALLERGENS=['nuts','dairy','gluten','eggs'];
const ING={yogurt:['Yogurt','g',6000,1500],granola:['Granola','g',2500,600],apples:['Apples','g',6000,1500],pumpkin:['Pumpkin purée','g',3000,800],pecans:['Pecans','g',800,250],flour:['Flour','g',9000,2000],butter:['Butter','g',3000,800],sugar:['Sugar','g',3500,800],eggs:['Eggs','',60,12],almonds:['Almonds','g',700,200]};
// ING = [label, unit, full stock, low-stock threshold]
const MIN_PER_ORDER=2, WAGE=18, WASTE_RATE=0.04;

/* ---------- State (localStorage so two tabs sync live) ---------- */
const KEY='bakeria-demo-v1';
let S;
function fresh(){const inv={};for(const k in ING)inv[k]=ING[k][2];return{orders:[],inv,seq:100}}
function load(){try{S=JSON.parse(localStorage.getItem(KEY))||fresh()}catch(e){S=fresh()}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
load();
let cart={},hide=[],name='',last=null;

const $=s=>document.querySelector(s);
const money=n=>'$'+n.toFixed(2);
const item=id=>MENU.find(m=>m.id===id);
const canMake=(m,q=1)=>Object.entries(m.r).every(([k,v])=>S.inv[k]>=v*q);

/* ---------- Actions ---------- */
function toggleHide(a){hide=hide.includes(a)?hide.filter(x=>x!==a):[...hide,a];render()}
function add(id,d){const m=item(id),n=(cart[id]||0)+d;if(n<=0)delete cart[id];else if(canMake(m,n))cart[id]=n;render()}
function setName(v){name=v}
function place(){
  const ids=Object.keys(cart);if(!ids.length)return;
  const total=ids.reduce((t,i)=>t+item(i).price*cart[i],0);
  ids.forEach(i=>{for(const k in item(i).r)S.inv[k]=Math.max(0,S.inv[k]-item(i).r[k]*cart[i])});
  const o={id:++S.seq,name:name.trim()||'Guest',items:{...cart},total,t:Date.now(),done:false};
  S.orders.push(o);save();last=o;cart={};render();
}
function newOrder(){last=null;render()}
function done(id){const o=S.orders.find(o=>o.id===id);o.done=!o.done;save();render()}
function resetDemo(){S=fresh();save();render()}
function seedDay(){
  S=fresh();let t=Date.now()-6*3600e3;
  for(let n=0;n<28;n++){
    const its={};const c=1+Math.floor(Math.random()*3);
    for(let j=0;j<c;j++){const w=Math.random()<.35?MENU[0]:MENU[Math.floor(Math.random()*MENU.length)];if(canMake(w,(its[w.id]||0)+1))its[w.id]=(its[w.id]||0)+1}
    if(!Object.keys(its).length)continue;
    let tot=0;for(const i in its){tot+=item(i).price*its[i];for(const k in item(i).r)S.inv[k]-=item(i).r[k]*its[i]}
    t+=Math.random()*14*60e3;
    S.orders.push({id:++S.seq,name:['Maya','Sam','Priya','Leo','Jo','Alex','Nina'][n%7],items:its,total:tot,t,done:n<24});
  }
  save();render();
}

/* ---------- Customer view ---------- */
function customer(){
  const shown=MENU.filter(m=>!m.al.some(a=>hide.includes(a)));
  const ids=Object.keys(cart);
  const total=ids.reduce((t,i)=>t+item(i).price*cart[i],0);
  const cartHTML=last?`
    <div class="panel confirm" role="status">
      <p>Order placed. Your number is</p><div class="num">#${last.id}</div>
      <p>Thanks, ${last.name}! Pay at the counter: <b>${money(last.total)}</b></p>
      <button class="btn" onclick="newOrder()">Order something else</button>
    </div>`:`
    <div class="panel cart"><h2>Your order</h2>
      ${ids.length?ids.map(i=>`<div class="line"><span>${cart[i]} × ${item(i).name}</span><span>${money(item(i).price*cart[i])}</span></div>`).join(''):'<p class="empty">Tap "Add" on anything you like.</p>'}
      <div class="total">Total ${money(total)}</div>
      <label for="nm">Name or table number</label>
      <input id="nm" value="${name.replace(/"/g,'&quot;')}" oninput="setName(this.value)" placeholder="e.g. Table 4">
      <button class="btn" style="width:100%" ${ids.length?'':'disabled'} onclick="place()">Place order</button>
      <p class="note">Pay at the counter when you pick up.</p>
    </div>`;
  return `
  <h2 class="lead">Fresh today</h2>
  <p class="sub">Order from your phone. Allergens are listed on every item.</p>
  <div class="chips"><span>Hide anything with:</span>
    ${ALLERGENS.map(a=>`<button class="chip ${hide.includes(a)?'on':''}" aria-pressed="${hide.includes(a)}" onclick="toggleHide('${a}')">${a}</button>`).join('')}
  </div>
  <div class="layout">
    <div class="grid">${shown.length?shown.map(m=>{
      const ok=canMake(m,(cart[m.id]||0)+1),inCart=cart[m.id]||0;
      return `<article class="item"><div class="pic" style="background:${m.bg}" aria-hidden="true">${m.e}</div>
      <div class="body"><div class="row"><h3>${m.name}</h3><span class="price">${money(m.price)}</span></div>
      <p class="ing">${m.ing}</p>
      <div class="tags">${m.al.length?m.al.map(a=>`<span class="tag">contains ${a}</span>`).join(''):'<span class="tag free">no common allergens</span>'}</div>
      <div style="margin-top:auto">${inCart?`<div class="qty"><button aria-label="Remove one ${m.name}" onclick="add('${m.id}',-1)">−</button><b>${inCart}</b><button aria-label="Add one ${m.name}" onclick="add('${m.id}',1)" ${ok?'':'disabled'}>+</button></div>`
        :`<button class="btn" style="width:100%" ${ok?'':'disabled'} onclick="add('${m.id}',1)">${ok?'Add':'Sold out'}</button>`}</div>
      </div></article>`}).join(''):'<p class="empty">Everything on the menu has one of those allergens. Clear a filter to see more.</p>'}
    </div>
    ${cartHTML}
  </div>`;
}

/* ---------- Grandma view ---------- */
function grandma(){
  const O=S.orders,sales=O.reduce((t,o)=>t+o.total,0);
  const mins=O.length*MIN_PER_ORDER,laborSaved=mins/60*WAGE,waste=sales*WASTE_RATE;
  const low=Object.keys(ING).filter(k=>S.inv[k]<=ING[k][3]);
  const counts={};O.forEach(o=>{for(const i in o.items)counts[i]=(counts[i]||0)+o.items[i]});
  const best=MENU.map(m=>[m,counts[m.id]||0]).sort((a,b)=>b[1]-a[1]);
  const max=Math.max(1,best[0][1]);
  const pending=O.filter(o=>!o.done).length;
  const orders=[...O].reverse();
  return `
  <h2 class="lead">Today at the shop</h2>
  <p class="sub">Updates the moment a customer orders. Open the customer menu in another tab to try it.</p>
  ${low.length?`<div class="alert" role="alert">Running low: ${low.map(k=>`${ING[k][0]} (${Math.round(S.inv[k])}${ING[k][1]} left)`).join(', ')}. Time to reorder.</div>`:''}
  <div class="stats">
    <div class="stat">Orders today<b>${O.length}</b>${pending} still to bake or hand over</div>
    <div class="stat">Sales today<b>${money(sales)}</b>paid at counter</div>
    <div class="stat save">Time saved<b>${(mins/60).toFixed(1)} hrs</b>at ${MIN_PER_ORDER} min per hand-taken order</div>
    <div class="stat save">Money saved<b>${money(laborSaved+waste)}</b>${money(laborSaved)} labor + ${money(waste)} less waste</div>
  </div>
  <div class="cols">
    <section class="panel"><h2>Orders</h2>
      ${orders.length?orders.slice(0,12).map(o=>`<div class="order ${o.done?'done':''}">
        <div><b>#${o.id} · ${o.name}</b><small>${Object.entries(o.items).map(([i,q])=>q+' × '+item(i).name).join(', ')}</small>
        <small>${new Date(o.t).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'})} · ${money(o.total)}</small></div>
        <button class="btn sm ${o.done?'alt':''}" onclick="done(${o.id})">${o.done?'Undo':'Mark done'}</button></div>`).join(''):'<p class="empty">No orders yet. Load a sample day or place one from the customer menu.</p>'}
    </section>
    <section class="panel"><h2>Inventory</h2>
      ${Object.keys(ING).map(k=>{const [l,u,full,th]=ING[k],v=S.inv[k],isLow=v<=th;
        return `<div class="inv"><div class="row"><span>${l}</span><span class="${isLow?'low-t':''}">${Math.round(v)}${u} ${isLow?'· low':''}</span></div>
        <div class="bar"><i class="${isLow?'low':''}" style="width:${Math.max(2,v/full*100)}%"></i></div></div>`}).join('')}
    </section>
  </div>
  <div class="cols">
    <section class="panel"><h2>Best sellers</h2>
      ${best.map(([m,n])=>`<div class="bs"><span>${m.name}</span><div class="bar"><i style="width:${n/max*100}%"></i></div><b>${n}</b></div>`).join('')}
    </section>
    <section class="panel"><h2>Menu QR code</h2>
      <div id="qr"></div>
      <p class="note">Points to the customer menu on this address. To scan with a phone, run a local server (see the note I sent with this file) so the link works on your Wi-Fi.</p>
      <div class="tools"><button class="btn sm" onclick="seedDay()">Load sample day</button><button class="btn sm alt" onclick="resetDemo()">Reset everything</button></div>
    </section>
  </div>
  <p class="note">Savings assume ${MIN_PER_ORDER} min of staff time per hand-taken order at $${WAGE}/hr, plus ${WASTE_RATE*100}% of sales in avoided waste. Edit the numbers at the top of the script.</p>`;
}

/* ---------- Router ---------- */
function render(){
  const g=location.hash.startsWith('#/grandma');
  $('#t-c').className=g?'':'on';$('#t-g').className=g?'on':'';
  const f=document.activeElement&&document.activeElement.id;
  $('#app').innerHTML=g?grandma():customer();
  if(g){const q=$('#qr');if(q&&window.QRCode)new QRCode(q,{text:location.href.split('#')[0]+'#/',width:128,height:128});else if(q)q.textContent='QR needs internet to load'}
  if(f==='nm'){const el=$('#nm');if(el){el.focus();el.setSelectionRange(el.value.length,el.value.length)}}
}
window.addEventListener('hashchange',render);
window.addEventListener('storage',e=>{if(e.key===KEY){load();render()}});
render();
</script>
</body>
</html>
