<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Grandma's Bakeria · Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Young+Serif&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--ink:#35192e;--plum:#6b2d5c;--berry:#a63d6f;--butter:#f7d774;--pist:#b5d3a4;--paper:#fbf7fb;--line:#e6d9e3;--warn:#c2410c;--ok:#2f7a4b;color-scheme:light}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.5 'DM Sans',system-ui,sans-serif}
h1,h2,h3{font-family:'Young Serif',Georgia,serif;font-weight:400;margin:0}
h2{font-size:1.4rem;margin-bottom:10px}h3{font-size:1.05rem;margin:14px 0 4px}
button,select{font:inherit;cursor:pointer}:focus-visible{outline:3px solid var(--berry);outline-offset:2px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:12px 24px;background:var(--ink)}
.top h1{font-size:1.4rem;color:var(--butter)}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tabs button,.size button{color:#fff;background:none;padding:8px 16px;border-radius:99px;border:1px solid #ffffff55}
.tabs button.on{background:var(--butter);color:var(--ink);border-color:var(--butter);font-weight:700}
.size{display:flex;gap:6px;align-items:center;color:#fff}
main{max-width:1100px;margin:0 auto;padding:24px}
.lead{font-size:1.9rem;margin-bottom:4px}.sub{color:#6e5668;margin:0 0 18px}
.chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.chip{padding:6px 14px;border-radius:99px;border:1.5px solid var(--plum);background:#fff;color:var(--plum)}
.chip.on{background:var(--plum);color:#fff}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}
@media(max-width:820px){.cols{grid-template-columns:1fr}}
.panel,.stat{background:#fff;border:1px solid var(--line);border-radius:14px}.panel{padding:18px}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.btn{border:0;border-radius:10px;padding:10px 14px;background:var(--plum);color:#fff;font-weight:700}
.btn:hover{background:var(--berry)}.btn:disabled{background:#cdbfc9;cursor:not-allowed}
.btn.alt{background:#fff;color:var(--plum);border:1.5px solid var(--plum)}.btn.sm{padding:6px 10px;font-size:.9rem}
input[type=text],input[type=search],input[type=number]{padding:9px;border:1.5px solid var(--line);border-radius:8px;font:inherit;width:100%}
input[type=number]{width:90px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:20px}
.stat{padding:16px;font-size:.9rem}.stat b{display:block;font-family:'Young Serif',serif;font-size:1.8rem;font-weight:400}
.stat.save{background:var(--pist);border-color:var(--pist)}
.alert{background:#fff1e6;border:1.5px solid var(--warn);color:var(--warn);border-radius:12px;padding:12px 16px;margin-bottom:20px;font-weight:500}
.order{padding:12px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px}
.order.done{opacity:.55}.order.late{border-left:4px solid var(--warn);padding-left:10px}
.order small{display:block;color:#6e5668}
.bar{height:10px;background:#efe3ec;border-radius:6px;overflow:hidden;margin-top:4px}
.bar i{display:block;height:100%;background:var(--ok)}.bar i.low{background:var(--warn)}
.inv{padding:10px 0;border-bottom:1px solid var(--line)}.low-t{color:var(--warn);font-weight:700}
.bs{display:grid;grid-template-columns:150px 1fr 34px;gap:10px;align-items:center;margin:8px 0}
.bs .bar{margin:0;height:14px}.bs .bar i{background:var(--berry)}
.note{font-size:.85rem;color:#6e5668}.empty{color:#8a7684}
.sl{display:grid;grid-template-columns:200px 1fr 60px;gap:10px;align-items:center;margin:8px 0}
.sl input{width:100%}
.ok{color:var(--ok);font-weight:700}
.off{opacity:.6}
table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line)}
svg circle{cursor:pointer}
</style>
</head>
<body>
<header class="top">
  <h1>Grandma's Bakeria</h1>
  <nav class="tabs" id="tabs" aria-label="Sections"></nav>
  <div class="size" role="group" aria-label="Text size">Text <button onclick="resize(-15)" aria-label="Smaller text">A−</button><button onclick="resize(15)" aria-label="Larger text">A+</button></div>
</header>
<main id="app"></main>

<script>
/* ---------- Data (edit freely) ---------- */
const MENU=[
 {id:'parfait',name:'Fall Parfait',price:7.5,r:{yogurt:120,granola:40,apples:60,pumpkin:20,pecans:5}},
 {id:'donut',name:'Apple Cider Donut',price:3.25,r:{flour:70,apples:20,butter:20,sugar:25,eggs:0.5}},
 {id:'loaf',name:'Pumpkin Loaf Slice',price:4,r:{flour:60,pumpkin:50,sugar:25,eggs:0.5,butter:15,pecans:8}},
 {id:'croissant',name:'Almond Croissant',price:4.75,r:{flour:60,butter:35,almonds:20,sugar:10,eggs:0.3}},
 {id:'scone',name:'Maple Pecan Scone',price:3.75,r:{flour:80,butter:30,pecans:15,sugar:15,eggs:0.3}},
 {id:'applecup',name:'Baked Apple Cup',price:3.5,r:{apples:150,sugar:15,flour:15}}
];
const ING={yogurt:['Yogurt','g',6000],granola:['Granola','g',2500],apples:['Apples','g',6000],pumpkin:['Pumpkin purée','g',3000],pecans:['Pecans','g',800],flour:['Flour','g',9000],butter:['Butter','g',3000],sugar:['Sugar','g',3500],eggs:['Eggs','',60],almonds:['Almonds','g',700]};
const LOW=.25, NAMES=['Maya','Sam','Priya','Leo','Jo','Alex','Nina','Table 4','Table 7'];
const TABS=[['today','Today'],['orders','Orders'],['sales','Sales'],['stock','Stock'],['menu','Menu & prices']];

/* ---------- State (saved in this browser) ---------- */
const KEY='bakeria-grandma-v1',rnd=(a,b)=>a+Math.random()*(b-a);
const money=n=>'$'+Number(n).toFixed(2),$=s=>document.querySelector(s);
const dkey=t=>new Date(t).toLocaleDateString('en-CA'),ago=t=>Math.max(0,Math.round((Date.now()-t)/60000));
const hr12=h=>(h%12||12)+(h<12?'a':'p'),item=id=>MENU.find(m=>m.id===id);
let S,tab='today',days=7,selDay=dkey(Date.now()),filter='pending',q='',openId=null;
function fresh(){const inv={},menu={};for(const k in ING)inv[k]=ING[k][2];MENU.forEach(m=>menu[m.id]={price:m.price,off:false});return{orders:[],inv,menu,seq:1000,size:100,as:{min:2,wage:18,waste:4}}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
function seedHistory(){
  const keep=S&&{menu:S.menu,size:S.size,as:S.as};S=Object.assign(fresh(),keep||{});const now=Date.now();
  for(let d=13;d>=0;d--){
    const day=new Date(now-d*864e5),wk=[0,6].includes(day.getDay()),n=Math.round(rnd(14,24)*(wk?1.5:1)*(1+(13-d)*.02));
    for(let i=0;i<n;i++){
      let h=Math.round((rnd(7,17)+rnd(7,17))/2);if(d===0)h=Math.min(h,new Date().getHours());
      const t=new Date(day);t.setHours(h,Math.floor(rnd(0,60)),0,0);if(+t>now)continue;
      const its={};for(let j=Math.ceil(rnd(0,3));j>0;j--){const m=Math.random()<.3?MENU[0]:MENU[Math.floor(rnd(0,MENU.length))];its[m.id]=(its[m.id]||0)+1}
      S.orders.push({name:NAMES[i%NAMES.length],items:its,total:Object.entries(its).reduce((s,[k,v])=>s+item(k).price*v,0),t:+t,done:now-t>15*60e3});
    }
  }
  S.orders.sort((a,b)=>a.t-b.t).forEach(o=>o.id=++S.seq);
  for(const k in ING)S.inv[k]=ING[k][2]*({pecans:.2,granola:.22}[k]??rnd(.4,.9));
  save();
}
try{S=JSON.parse(localStorage.getItem(KEY))}catch(e){}
if(!S)seedHistory();

/* ---------- Actions ---------- */
const go=t=>{tab=t;render()};
function resize(d){S.size=Math.min(160,Math.max(85,S.size+d));save();render()}
function setDone(id,v){S.orders.find(o=>o.id===id).done=v;save();render()}
function canMake(m,n=1){return Object.entries(m.r).every(([k,v])=>S.inv[k]>=v*n)}
function simulate(){ // stands in for a customer ordering from the QR menu
  const avail=MENU.filter(m=>!S.menu[m.id].off&&canMake(m)),its={};
  if(!avail.length)return alert('Nothing is available to order right now.');
  for(let j=Math.ceil(rnd(0,3));j>0;j--){const m=avail[Math.floor(rnd(0,avail.length))];if(canMake(m,(its[m.id]||0)+1))its[m.id]=(its[m.id]||0)+1}
  let total=0;for(const i in its){total+=S.menu[i].price*its[i];for(const k in item(i).r)S.inv[k]=Math.max(0,S.inv[k]-item(i).r[k]*its[i])}
  S.orders.push({id:++S.seq,name:NAMES[Math.floor(rnd(0,NAMES.length))],items:its,total,t:Date.now(),done:false});save();render();
}
function pickDay(d){selDay=d;render()}
function setDays(d){days=d;render()}
function setInv(k,v){S.inv[k]=Math.max(0,+v||0);save();render()}
function addInv(k){const v=+$('#add-'+k).value;if(v>0)setInv(k,S.inv[k]+v)}
function setPrice(id,v){S.menu[id].price=Math.max(0,+v||0);save();render()}
function toggleOff(id){S.menu[id].off=!S.menu[id].off;save();render()}
function setAs(k,v){S.as[k]=+v;save();render()}
function sample(){if(confirm('Replace today\'s data with a fresh sample?')){seedHistory();render()}}
function clearAll(){if(confirm('Clear all orders and refill stock?')){const keep={menu:S.menu,size:S.size,as:S.as};S=Object.assign(fresh(),keep);save();render()}}

/* ---------- Charts ---------- */
function areaChart(s){
  const W=600,H=220,L=46,B=26,T=10,R=10,mx=Math.max(10,...s.map(d=>d.rev));
  const y=v=>T+(H-T-B)*(1-v/mx),x=i=>L+(W-L-R)*(s.length>1?i/(s.length-1):.5),pts=s.map((d,i)=>x(i)+','+y(d.rev)).join(' '),step=Math.ceil(s.length/7);
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Sales per day. Tap a dot for that day." style="width:100%">
  ${[0,.5,1].map(f=>`<line x1="${L}" x2="${W-R}" y1="${y(mx*f)}" y2="${y(mx*f)}" stroke="#eadfe7"/><text x="${L-6}" y="${y(mx*f)+4}" text-anchor="end" font-size="11" fill="#6e5668">$${Math.round(mx*f)}</text>`).join('')}
  <polygon points="${x(0)},${y(0)} ${pts} ${x(s.length-1)},${y(0)}" fill="#e7c9dc"/><polyline points="${pts}" fill="none" stroke="#6b2d5c" stroke-width="2.5"/>
  ${s.map((d,i)=>{const sel=d.date===selDay;return `<circle cx="${x(i)}" cy="${y(d.rev)}" r="${sel?8:4.5}" fill="${sel?'#f7d774':'#6b2d5c'}" stroke="#6b2d5c" stroke-width="2" onclick="pickDay('${d.date}')"><title>${d.date}: ${money(d.rev)}, ${d.n} orders</title></circle>${i%step?'':`<text x="${x(i)}" y="${H-8}" text-anchor="middle" font-size="11" fill="#6e5668">${d.date.slice(5)}</text>`}`}).join('')}</svg>`;
}
function hourChart(c){
  const a=7,b=18,W=600,H=180,L=10,B=24,T=8,v=c.slice(a,b+1),mx=Math.max(1,...v),bw=(W-L)/v.length;
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Orders by hour" style="width:100%">${v.map((n,i)=>{const h=(H-T-B)*n/mx;return `<rect x="${L+i*bw+4}" y="${H-B-h}" width="${bw-8}" height="${h}" rx="3" fill="#a63d6f"><title>${hr12(a+i)}: ${n} orders</title></rect><text x="${L+i*bw+bw/2}" y="${H-8}" text-anchor="middle" font-size="11" fill="#6e5668">${hr12(a+i)}</text>`}).join('')}</svg>`;
}

/* ---------- Shared bits ---------- */
const itemsText=o=>Object.entries(o.items).map(([i,n])=>n+' × '+item(i).name).join(', ');
const orderRow=o=>`<div class="order ${o.done?'done':ago(o.t)>10?'late':''}"><div><b>#${o.id} · ${o.name}</b><small>${itemsText(o)}</small><small>${new Date(o.t).toLocaleString([],{weekday:'short',hour:'numeric',minute:'2-digit'})}${o.done?'':' · '+ago(o.t)+' min ago'} · ${money(o.total)}</small></div>
  <button class="btn sm ${o.done?'alt':''}" onclick="setDone(${o.id},${!o.done})">${o.done?'Undo':'Mark ready'}</button></div>`;
const lowList=()=>Object.keys(ING).filter(k=>S.inv[k]<=ING[k][2]*LOW);
const alertBox=()=>lowList().length?`<div class="alert" role="alert">Running low: ${lowList().map(k=>`${ING[k][0]} (${Math.round(S.inv[k])}${ING[k][1]} left)`).join(', ')}. <a href="#" onclick="go('stock');return false" style="color:inherit">Go to Stock</a></div>`:'';
function stats(n){ // totals for the last n days
  const ser=[...Array(n)].map((_,i)=>{const date=dkey(Date.now()-(n-1-i)*864e5),os=S.orders.filter(o=>dkey(o.t)===date);return{date,n:os.length,rev:os.reduce((s,o)=>s+o.total,0)}});
  const rev=ser.reduce((s,d)=>s+d.rev,0),cnt=ser.reduce((s,d)=>s+d.n,0),hrs=cnt*S.as.min/60;
  return{ser,rev,cnt,aov:cnt?rev/cnt:0,hrs,labor:hrs*S.as.wage,waste:rev*S.as.waste/100};
}

/* ---------- Screens ---------- */
function vToday(){
  const st=stats(days),t=st.ser.at(-1),p=st.ser.at(-2)||{rev:0},d=t.rev-p.rev,pend=S.orders.filter(o=>!o.done).sort((a,b)=>a.t-b.t);
  return `<h2 class="lead">Today at the shop</h2><p class="sub">Tap a button to act. Everything saves automatically.</p>${alertBox()}
  <div class="stats"><div class="stat">Sales today<b>${money(t.rev)}</b>${d>=0?'+':'−'}${money(Math.abs(d))} vs yesterday</div>
  <div class="stat">Orders today<b>${t.n}</b>${pend.length} waiting right now</div>
  <div class="stat">Average order<b>${money(st.aov)}</b>last ${days} days</div>
  <div class="stat save">Time saved<b>${st.hrs.toFixed(1)} hrs</b>last ${days} days</div>
  <div class="stat save">Money saved<b>${money(st.labor+st.waste)}</b>${money(st.labor)} labor + ${money(st.waste)} waste</div></div>
  <section class="panel"><div class="row"><h2>Orders to make (${pend.length})</h2><button class="btn sm alt" onclick="simulate()">Simulate a customer order</button></div>
  ${pend.length?pend.map(orderRow).join(''):'<p class="empty">All caught up. New orders appear here.</p>'}</section>
  <div class="tools" style="margin-top:20px;display:flex;gap:10px;flex-wrap:wrap"><button class="btn sm" onclick="sample()">Load sample data</button><button class="btn sm alt" onclick="clearAll()">Clear all orders</button></div>`;
}
function vOrders(){
  const list=S.orders.filter(o=>(filter==='all'||(filter==='pending')===!o.done)&&(!q||(o.name+' '+itemsText(o)+' #'+o.id).toLowerCase().includes(q.toLowerCase()))).sort((a,b)=>filter==='pending'?a.t-b.t:b.t-a.t);
  return `<h2 class="lead">Orders</h2><div class="chips">${[['pending','To make'],['done','Finished'],['all','All']].map(([f,l])=>`<button class="chip ${filter===f?'on':''}" onclick="filter='${f}';render()">${l}</button>`).join('')}
  <input type="search" id="q" value="${q.replace(/"/g,'&quot;')}" oninput="q=this.value;render()" placeholder="Search by name, item or number" aria-label="Search orders" style="max-width:320px"></div>
  <section class="panel">${list.length?list.slice(0,40).map(orderRow).join('')+(list.length>40?`<p class="note">Showing the 40 most recent of ${list.length}. Use search to narrow down.</p>`:''):'<p class="empty">No orders match.</p>'}</section>`;
}
function plan(){
  const wd=new Date(Date.now()+864e5).getDay(),by={};
  S.orders.forEach(o=>{const k=dkey(o.t);if(k===dkey(Date.now()))return;const e=by[k]||(by[k]={t:o.t,i:{}});for(const i in o.items)e.i[i]=(e.i[i]||0)+o.items[i]});
  const all=Object.values(by),same=all.filter(d=>new Date(d.t).getDay()===wd),use=same.length?same:all;
  const rows=MENU.map(m=>({m,n:Math.ceil((use.length?use.reduce((s,d)=>s+(d.i[m.id]||0),0)/use.length:0)*1.1)}));
  const need={};rows.forEach(({m,n})=>{for(const k in m.r)need[k]=(need[k]||0)+m.r[k]*n});
  return{rows,short:Object.keys(need).filter(k=>need[k]>S.inv[k]).map(k=>[ING[k][0],Math.ceil(need[k]-S.inv[k]),ING[k][1]]),day:new Date(Date.now()+864e5).toLocaleDateString([],{weekday:'long'})};
}
function vSales(){
  const st=stats(days),inR=S.orders.filter(o=>o.t>=Date.now()-days*864e5),cnt={};
  inR.forEach(o=>{for(const i in o.items)cnt[i]=(cnt[i]||0)+o.items[i]});
  const best=MENU.map(m=>[m,cnt[m.id]||0]).sort((a,b)=>b[1]-a[1]),top=Math.max(1,best[0][1]),bh=Array(24).fill(0);inR.forEach(o=>bh[new Date(o.t).getHours()]++);
  const dOrders=S.orders.filter(o=>dkey(o.t)===selDay),dRev=dOrders.reduce((s,o)=>s+o.total,0),dc={};
  dOrders.forEach(o=>{for(const i in o.items)dc[i]=(dc[i]||0)+o.items[i]});
  const pl=plan(),sl=(k,l,min,max,step,fmt)=>`<div class="sl"><label>${l}</label><input type="range" min="${min}" max="${max}" step="${step}" value="${S.as[k]}" oninput="this.nextElementSibling.textContent='${fmt[0]}'+this.value+'${fmt[1]}'" onchange="setAs('${k}',this.value)" aria-label="${l}"><b>${fmt[0]}${S.as[k]}${fmt[1]}</b></div>`;
  return `<h2 class="lead">Sales</h2>
  <section class="panel"><div class="row"><h2>Sales over time</h2><div class="chips">${[7,14].map(d=>`<button class="chip ${d===days?'on':''}" onclick="setDays(${d})">${d} days</button>`).join('')}</div></div>${areaChart(st.ser)}
  <h3>${new Date(selDay+'T12:00').toLocaleDateString([],{weekday:'long',month:'short',day:'numeric'})}: ${money(dRev)} from ${dOrders.length} orders</h3>
  <p class="note">Tap any dot on the chart to look at that day.</p>
  ${Object.keys(dc).length?`<p>${MENU.filter(m=>dc[m.id]).sort((a,b)=>dc[b.id]-dc[a.id]).map(m=>dc[m.id]+' × '+m.name).join(' · ')}</p>`:'<p class="empty">No orders that day.</p>'}</section>
  <div class="cols"><section class="panel"><h2>Best sellers</h2>${best.map(([m,n])=>`<div class="bs"><span>${m.name}</span><div class="bar"><i style="width:${n/top*100}%"></i></div><b>${n}</b></div>`).join('')}</section>
  <section class="panel"><h2>Busiest hours</h2>${hourChart(bh)}<p class="note">Bake more just before the tall bars.</p></section></div>
  <div class="cols"><section class="panel"><h2>Plan for ${pl.day}</h2><p class="note">Based on what sold on past ${pl.day}s, plus 10% extra.</p>
  <table>${pl.rows.map(({m,n})=>`<tr><td>${m.name}</td><td><b>${n}</b> to bake</td></tr>`).join('')}</table>
  ${pl.short.length?`<p class="low-t">You will need more: ${pl.short.map(([n,v,u])=>`${n} (${v}${u} short)`).join(', ')}.</p>`:'<p class="ok">You have enough ingredients for this plan.</p>'}</section>
  <section class="panel"><h2>What does automation save?</h2><p class="note">Move the sliders to match your shop.</p>
  ${sl('min','Minutes per order by hand',0,5,.5,['',' min'])}${sl('wage','Staff cost per hour',10,40,1,['$',''])}${sl('waste','Waste avoided (% of sales)',0,10,.5,['','%'])}
  <p><b>${st.hrs.toFixed(1)} hours</b> and <b>${money(st.labor+st.waste)}</b> saved in ${days} days.</p></section></div>`;
}
function vStock(){
  return `<h2 class="lead">Stock</h2><p class="sub">Orders take ingredients out automatically. Type in deliveries when they arrive.</p>${alertBox()}
  <section class="panel">${Object.keys(ING).map(k=>{const [l,u,full]=ING[k],v=S.inv[k],low=v<=full*LOW;
    return `<div class="inv"><div class="row"><b>${l}</b><span class="${low?'low-t':''}">${Math.round(v)}${u} of ${full}${u}${low?' · low':''}</span></div>
    <div class="bar"><i class="${low?'low':''}" style="width:${Math.max(2,v/full*100)}%"></i></div>
    <div class="row" style="margin-top:8px"><span><label for="add-${k}">Delivery:</label> <input type="number" id="add-${k}" min="0" placeholder="amount"> <button class="btn sm" onclick="addInv('${k}')">Add</button></span>
    <button class="btn sm alt" onclick="setInv('${k}',${full})">Fill to full</button></div></div>`}).join('')}</section>`;
}
function vMenu(){
  return `<h2 class="lead">Menu & prices</h2><p class="sub">Change a price or mark something "out today".</p>
  <section class="panel">${MENU.map(m=>{const c=S.menu[m.id],ok=canMake(m);
    return `<div class="order ${c.off?'off':''}"><div><b>${m.name}</b><small>${c.off?'Hidden from customers today':ok?'Available':'Sold out: not enough ingredients'}</small></div>
    <div class="row"><label>$ <input type="number" step="0.25" min="0" value="${c.price}" onchange="setPrice('${m.id}',this.value)" aria-label="Price for ${m.name}"></label>
    <button class="btn sm ${c.off?'':'alt'}" onclick="toggleOff('${m.id}')">${c.off?'Put back on menu':'Out today'}</button></div></div>`}).join('')}
  <p class="note">New prices apply to new orders only.</p></section>`;
}

/* ---------- Router ---------- */
function render(){
  const f=document.activeElement&&document.activeElement.id,pos=document.activeElement&&document.activeElement.selectionStart;
  document.documentElement.style.fontSize=S.size+'%';
  $('#tabs').innerHTML=TABS.map(([id,l])=>`<button class="${tab===id?'on':''}" onclick="go('${id}')">${l}</button>`).join('');
  $('#app').innerHTML={today:vToday,orders:vOrders,sales:vSales,stock:vStock,menu:vMenu}[tab]();
  if(f==='q'){const el=$('#q');el.focus();el.setSelectionRange(pos,pos)}
}
window.addEventListener('storage',e=>{if(e.key===KEY){try{S=JSON.parse(e.newValue)}catch(x){}render()}});
setInterval(()=>{if(!['INPUT'].includes(document.activeElement.tagName))render()},30000); // refresh "x min ago"
render();
</script>
</body>
